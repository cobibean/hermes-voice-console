# Console auth and stable pseudonymous ownership. Keep these distinct.
VOICE_CONSOLE_SCOPE_SECRET=replace_me_with_a_random_value
VOICE_CONSOLE_SERVICE_TOKEN=replace_me_with_a_different_random_value

# Voice providers (set only what your selected providers require)
OPENAI_API_KEY=
VOICE_TOOLS_OPENAI_KEY=
