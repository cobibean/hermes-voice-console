  "source_files": ["gateway/platforms/api_server.py", "gateway/realtime/api.py", "gateway/realtime/contracts.py", "gateway/realtime/http.py", "gateway/realtime/session_manager.py", "gateway/realtime/state.py", "gateway/worker_jobs/runtime.py", "gateway/worker_jobs/store.py"],
  "contract_version": "1.0",
  "mutations": {
    "create": {
      "keys": ["contract_version", "realtime_session_id", "conversation_id", "session_generation", "state", "turn_mode", "answer_sdp", "client_request_id"],
      "types": {"contract_version": "string", "realtime_session_id": "string", "conversation_id": "string", "session_generation": "integer", "state": "string", "turn_mode": "string", "answer_sdp": "string", "client_request_id": "string"}
    },
    "activate": {
      "keys": ["contract_version", "realtime_session_id", "conversation_id", "session_generation", "state", "turn_mode", "answer_sdp", "client_request_id"],
      "types": {"contract_version": "string", "realtime_session_id": "string", "conversation_id": "string", "session_generation": "integer", "state": "string", "turn_mode": "string", "answer_sdp": "string", "client_request_id": "string"},
      "constants": {"state": "active"}
    },
    "input": {
      "keys": ["client_request_id", "accepted", "state"],
      "types": {"client_request_id": "string", "accepted": "boolean", "state": "string"},
      "constants": {"accepted": true, "state": "accepted"}
    },
    "manual_audio_commit": {
      "keys": ["client_request_id", "realtime_session_id", "session_generation", "state", "audio_commit_requested", "response_requested"],
      "types": {"client_request_id": "string", "realtime_session_id": "string", "session_generation": "integer", "state": "string", "audio_commit_requested": "boolean", "response_requested": "boolean"},
      "constants": {"state": "accepted", "audio_commit_requested": true, "response_requested": true}
    },
    "manual_audio_commit_rejected": {
      "keys": ["client_request_id", "operation", "state", "accepted", "error"],
      "types": {"client_request_id": "string", "operation": "string", "state": "string", "accepted": "boolean", "error": "object"},
      "constants": {"operation": "manual_audio_commit", "state": "rejected", "accepted": false, "error": {"code": "audio_buffer_empty"}}
    },
    "turn_mode_update": {
      "keys": ["client_request_id", "realtime_session_id", "session_generation", "turn_mode", "state"],
      "types": {"client_request_id": "string", "realtime_session_id": "string", "session_generation": "integer", "turn_mode": "string", "state": "string"},
      "constants": {"state": "accepted"}
    },
    "worker_command": {
      "keys": ["command_id", "worker_job_id", "acknowledgement", "revision", "operation", "control_signal_sent"],
      "types": {"command_id": "string", "worker_job_id": "string", "acknowledgement": "string", "revision": "integer", "operation": "string", "control_signal_sent": "boolean"}
    },
    "pending_approval_snapshot": {
      "keys": ["approval_id", "state", "tool_call_id", "tool_name", "expires_at"],
      "types": {"approval_id": "string", "state": "string", "tool_call_id": "string", "tool_name": "string", "expires_at": "number"}
    },
    "interrupt": {
      "keys": ["client_request_id", "realtime_session_id", "interrupted", "state"],
      "types": {"client_request_id": "string", "realtime_session_id": "string", "interrupted": "boolean", "state": "string"},
      "constants": {"interrupted": true, "state": "accepted"}
    },
    "approval": {
      "keys": ["client_request_id", "approval_id", "state", "accepted"],
      "types": {"client_request_id": "string", "approval_id": "string", "state": "string", "accepted": "boolean"},
      "constants": {"state": "resolved"}
    },
    "delete": {
      "keys": ["client_request_id", "realtime_session_id", "conversation_id", "state"],
      "types": {"client_request_id": "string", "realtime_session_id": "string", "conversation_id": "string", "state": "string"},
      "constants": {"state": "closed"}
    },
    "outcome_unknown": {
      "keys": ["client_request_id", "operation", "state", "accepted"],
      "types": {"client_request_id": "string", "operation": "string", "state": "string", "accepted": "boolean"},
      "constants": {"state": "outcome_unknown", "accepted": false}
    }
  }
